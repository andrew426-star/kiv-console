# Supabase (Foundation)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud (Calendar module + Autonomous Lead Engine's Sheets/Docs/
# Drive/Gmail access — same OAuth connection, broader scope)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Autonomous Lead Engine — Places API (New) + Geocoding, for company
# discovery. A plain Cloud Console API key, distinct from the OAuth
# Client ID/Secret above.
GOOGLE_PLACES_API_KEY=

# Autonomous Lead Engine — Hunter.io domain search, for contact enrichment.
HUNTER_API_KEY=

# Market data (nav ticker + Intel Hub watchlist)
FINNHUB_API_KEY=

# News feed
NEWSAPI_KEY=

# Research brief, all 15 Slack agents, and ALE's Stage 2/3/showcase
# generation — Gemini API (ai.google.dev), free tier, no credit card. Get a
# key at https://aistudio.google.com/apikey. Claude/ANTHROPIC_API_KEY is no
# longer used anywhere in this app.
GEMINI_API_KEY=

# Web search — used by agents (Atlas, Meridian, Cipher, Forge, Blueprint,
# Broadcast) and by ALE's Stage 2/3 research. Tavily, free tier (1,000
# searches/month, no card). Gemini's own built-in search grounding requires
# billing even on a free project, so this is a custom function tool
# instead. Get a key at https://tavily.com.
TAVILY_API_KEY=

# Forge's one real action — opens a GitHub issue in kiv-console to propose/
# track a build. Use a fine-grained PAT (github.com/settings/tokens,
# "Fine-grained tokens") scoped to ONLY the kiv-console repo, permission
# "Issues: Read and write" — not a broad classic PAT.
GITHUB_TOKEN=

# Optional — city/region for the Research brief's weather section
# (e.g. "New Orleans"). Omitted entirely (not guessed) if unset.
WEATHER_LOCATION=

# Shared bearer token external agent backends (Slack bot, Jarvis, etc.) use
# to POST to /api/agents/log. Generate with: openssl rand -hex 32
AGENT_LOG_API_KEY=

# Shared bearer token the weekday-batch GitHub Actions cron uses to POST to
# /api/ale/batch. Generate with: openssl rand -hex 32
ALE_BATCH_API_KEY=

# Portfolio page — Company Financials. A Stripe Restricted API Key scoped
# read-only to Balance + Balance Transactions (not the full secret key).
STRIPE_SECRET_KEY=

# Portfolio page — Investment Account (Alpaca, read-only: K.I.V. never
# places orders). Defaults to the paper-trading API; set
# ALPACA_API_BASE_URL=https://api.alpaca.markets once trading real money
# with live keys (paper and live are separate key pairs).
ALPACA_API_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_API_BASE_URL=

# Slack agent team — each of the 15 agents (see src/lib/agents/roster.ts for
# the full id list) is its own Slack app with its own bot token + signing
# secret. Naming convention: SLACK_BOT_TOKEN_<AGENT_ID>, uppercase, e.g.
#   SLACK_BOT_TOKEN_ATLAS=xoxb-...
#   SLACK_SIGNING_SECRET_ATLAS=...
# One pair per agent id: ATLAS, MERIDIAN, ORACLE, CIPHER, FORGE, BLUEPRINT,
# PIPELINE, PULSE, LEDGER, TICKER, BROADCAST, CANVAS, NEXUS, ACCORD, CHRONICLE

# Jarvis — Andrew's separate personal AI assistant (NOT a K.I.V. roster
# agent, see src/lib/agents/roster.ts). Jarvis already has its own Slack
# app; this is that existing bot's token. Used to message a target K.I.V.
# agent (POST /api/jarvis/notify, same AGENT_LOG_API_KEY bearer auth as
# /api/agents/log). Requires the chat:write scope, and Jarvis's app must
# be installed in the SAME Slack workspace as the 15 agent apps.
SLACK_BOT_TOKEN_JARVIS=

# Slack has no bot-to-bot DM support (conversations.open rejects it with
# cannot_dm_bot — confirmed live), so Jarvis and all 15 agent bots share
# one channel instead. /api/jarvis/notify posts there and @mentions the
# specific target agent — app_mention already replies for any sender, so
# no additional per-agent Slack scopes/subscriptions are needed. Create
# the channel once in Slack's UI, invite Jarvis's bot + all 15 agent bots,
# and set this to its channel ID.
SLACK_JARVIS_CHANNEL=

# Public base URL for links K.I.V. generates that get sent outside the app
# (currently: ALE's personalized /pitch/[slug] landing pages). Server-only,
# never NEXT_PUBLIC_ — falls back to VERCEL_PROJECT_PRODUCTION_URL, then
# localhost, if unset.
SITE_URL=
